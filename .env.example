# Any OpenAI-compatible chat endpoint works. Copy to .env and fill in.
# Free option: Google AI Studio key (https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Other free options:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.2   (no key)

# Optional: seconds before a call counts as failed (default 20000 ms)
# LLM_TIMEOUT_MS=20000
