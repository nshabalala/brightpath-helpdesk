{
  "name": "brightpath-helpdesk",
  "version": "1.0.0",
  "description": "Small AI help desk that answers only from three supplied documents, with sources.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ask": "node --env-file-if-exists=.env cli.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "cases": "node --env-file-if-exists=.env scripts/run-cases.js",
    "fail-demo": "node --env-file-if-exists=.env scripts/fail-demo.js"
  }
}
